#!/usr/bin/env bash
# A Bash script that displays subdomain information using dig

if [ "$#" -lt 1 ]; then
    exit 1
fi

DOMAIN=$1

for sub in www lb-01 web-01 web-02; do
    IP=$(dig +short ${sub}.${DOMAIN} | tail -n1)
    if [ -n "$IP" ]; then
        # Determine record type (CNAME or A)
        RECORD=$(dig +short TYPE:CNAME ${sub}.${DOMAIN})
        if [ -n "$RECORD" ]; then
            echo "The subdomain ${sub} is a CNAME record and points to ${IP}"
        else
            echo "The subdomain ${sub} is a A record and points to ${IP}"
        fi
    fi
done