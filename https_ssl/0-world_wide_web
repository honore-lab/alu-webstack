#!/usr/bin/env bash
# Script that displays information about subdomains (record type and destination IP)

if [ "$#" -lt 1 ]; then
    exit 1
fi

DOMAIN=$1

if [ "$#" -eq 2 ]; then
    sub=$2
    record_info=$(dig +noall +answer ${sub}.${DOMAIN} | grep -v '^;' | grep A | head -n1)
    if [ -n "$record_info" ]; then
        record_type=$(echo "$record_info" | awk '{print $(NF-1)}')
        destination=$(echo "$record_info" | awk '{print $NF}')
        if [ -n "$destination" ]; then
            echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
        fi
    fi
else
    for sub in www lb-01 web-01 web-02; do
        record_info=$(dig +noall +answer ${sub}.${DOMAIN} | grep -v '^;' | grep A | head -n1)
        if [ -n "$record_info" ]; then
            record_type=$(echo "$record_info" | awk '{print $(NF-1)}')
            destination=$(echo "$record_info" | awk '{print $NF}')
            if [ -n "$destination" ]; then
                echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
            fi
        fi
    done
fi