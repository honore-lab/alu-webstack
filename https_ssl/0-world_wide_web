#!/usr/bin/env bash
# A Bash script that displays subdomain information using dig

if [ "$#" -lt 1 ]; then
    exit 1
fi

DOMAIN=$1

for sub in www lb-01 web-01 web-02; do
    # Perform dig query and extract record type and IP destination
    record_info=$(dig +noall +answer ${sub}.${DOMAIN})
    if [ -n "$record_info" ]; then
        record_type=$(echo "$record_info" | head -n1 | awk '{print $4}')
        destination=$(echo "$record_info" | head -n1 | awk '{print $5}')
        if [ -n "$destination" ]; then
            echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
        fi
    fi
done