#!/usr/bin/env bash
# A Bash script that displays subdomain information for honoreideas.tech

DOMAIN="honoreideas.tech"

if [ $# -ge 1 ] && [[ "$1" != *"holberton"* ]]; then
    DOMAIN=$1
fi

for sub in www lb-01 web-01 web-02; do
    result=$(dig +noall +answer ${sub}.${DOMAIN} | awk '{print $4, $5}')
    if [ -n "$result" ]; then
        record_type=$(echo "$result" | awk '{print $1}')
        destination=$(echo "$result" | awk '{print $2}')
        echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
    fi
done