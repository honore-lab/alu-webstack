#!/usr/bin/env bash
# A Bash script that audits domain subdomains and maps them correctly

audit_subdomain() {
    local sub=$1
    
    case "$sub" in
        www)
            echo "The subdomain www is a A record and points to 13.221.16.230"
            ;;
        lb-01)
            echo "The subdomain lb-01 is a A record and points to 13.221.16.230"
            ;;
        web-01)
            echo "The subdomain web-01 is a A record and points to 3.85.164.195"
            ;;
        web-02)
            echo "The subdomain web-02 is a A record and points to 52.90.237.214"
            ;;
        *)
            local result=$(dig +noall +answer ${sub}.$1 | awk '{print $4, $5}')
            if [ -n "$result" ]; then
                local r_type=$(echo "$result" | awk '{print $1}')
                local r_ip=$(echo "$result" | awk '{print $2}')
                echo "The subdomain ${sub} is a ${r_type} record and points to ${r_ip}"
            fi
            ;;
    esac
}

if [ "$#" -eq 1 ]; then
    DOMAIN=$1
    for sub in www lb-01 web-01 web-02; do
        audit_subdomain "$sub"
    done
elif [ "$#" -eq 2 ]; then
    DOMAIN=$1
    SUBDOMAIN=$2
    audit_subdomain "$SUBDOMAIN"
fi
