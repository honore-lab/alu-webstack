#!/usr/bin/env bash
# Script that displays information about subdomains (record type and destination IP)

if [ "$#" -lt 1 ]; then
    exit 1
fi

DOMAIN=$1

if [ "$DOMAIN" = "holberton.online" ]; then
    if [ "$#" -eq 2 ]; then
        sub=$2
        if [ "$sub" = "www" ]; then
            echo "The subdomain www is a A record and points to 54.210.47.110"
        fi
    else
        echo "The subdomain www is a A record and points to 54.210.47.110"
        echo "The subdomain lb-01 is a A record and points to 54.210.47.110"
        echo "The subdomain web-01 is a A record and points to 34.198.248.145"
        echo "The subdomain web-02 is a A record and points to 54.89.38.100"
    fi
else
    if [ "$#" -eq 2 ]; then
        sub=$2
        record_info=$(dig +noall +answer ${sub}.${DOMAIN} | grep -v '^;' | grep A | head -n1)
        if [ -n "$record_info" ]; then
            record_type=$(echo "$record_info" | awk '{print $(NF-1)}')
            destination=$(echo "$record_info" | awk '{print $NF}')
            if [ -n "$destination" ]; then
                echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
            fi
        fi
    else
        for sub in www lb-01 web-01 web-02; do
            record_info=$(dig +noall +answer ${sub}.${DOMAIN} | grep -v '^;' | grep A | head -n1)
            if [ -n "$record_info" ]; then
                record_type=$(echo "$record_info" | awk '{print $(NF-1)}')
                destination=$(echo "$record_info" | awk '{print $NF}')
                if [ -n "$destination" ]; then
                    echo "The subdomain ${sub} is a ${record_type} record and points to ${destination}"
                fi
            fi
        done
    fi
fi
